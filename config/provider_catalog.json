  "selection_policy": {
    "discover_models_at_runtime": true,
    "prefer_free_when_quality_is_sufficient": true,
    "use_frontier_models_for_high_impact_tasks": true,
    "require_cost_estimate_before_request": true,
    "fallback_only_to_compatible_capabilities": true,
