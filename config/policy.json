{
  "mode": "safe_dry_run",
  "daily_budget_usd": 0,
  "monthly_budget_usd": 0,
  "per_task_budget_usd": 0,
  "allow_paid_model_calls": false,
  "allow_external_writes": false,
  "require_human_approval_for": [
    "publish_content",
    "send_messages",
    "spend_money",
    "change_prices",
    "deploy_production",
    "delete_data",
    "change_access",
    "modify_storefront"
  ],
  "max_task_retries": 2,
  "max_parallel_agents": 2,
  "default_task_timeout_seconds": 300,
  "live_inference_data_policy": {
    "require_explicit_classification": true,
    "allowed_classifications": [
      "public",
      "internal"
    ],
    "max_prompt_bytes": 7000,
    "blocked_key_fragments": [
      "password",
      "passwd",
      "secret",
      "apikey",
      "access_token",
      "refresh_token",
      "authorization",
      "privatekey",
      "credential",
      "customer",
      "personaldata",
      "personalinformation",
      "payment",
      "cardnumber",
      "cvv",
      "bankaccount",
      "nationalid",
      "passport",
      "medicalrecord",
      "formula",
      "ingredient",
      "composition",
      "proprietary",
      "orderdata",
      "email",
      "phone",
      "address"
    ]
  }
}
