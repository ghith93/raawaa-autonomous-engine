# Current milestone needs no credentials.
# Do not add wallet keys, exchange API secrets, or private provider tokens here.

# Telegram bot is optional and stays disabled until both values are supplied.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Paper capture defaults to local SQLite. D1 mode is staged and requires a separately
# deployed Worker plus migration 0004 applied to a dedicated non-production D1 database.
RAAWAA_PAPER_LEDGER_BACKEND=sqlite
RAAWAA_ENGINE_API_URL=
# Supply tokens through a protected secret environment; never commit actual values.
RAAWAA_ENGINE_API_TOKEN=
# Optional Cloudflare Access service-token pair (both or neither).
RAAWAA_ENGINE_CF_ACCESS_CLIENT_ID=
RAAWAA_ENGINE_CF_ACCESS_CLIENT_SECRET=
