diff --git a/scripts/axe_loader.py b/scripts/axe_loader.py
new file mode 100644
index 0000000..49d559e
--- /dev/null
+++ b/scripts/axe_loader.py
@@ -0,0 +1,164 @@
+"""Load the vendored axe-core bundle without weakening the production CSP.
+
+The storefront ships `script-src 'self' https://connect.facebook.net`
+(`_headers`). Playwright's `page.add_script_tag(content=...)` appends an inline
+`<script>` element, which that policy blocks — so the accessibility audit and
+the browser suites failed for a harness reason, not because the page scripts
+were broken.
+
+Correct fix: serve the vendored bundle over a *same-origin* test-only URL that
+`script-src 'self'` already permits, and inject it as an external script. The
+route is fulfilled from `scripts/vendor/axe.min.js` inside the test browser
+only; nothing is added to the production build, and the CSP is left untouched.
+
+Usage:
+
+    from axe_loader import install_axe_route, load_axe, assert_inline_scripts_blocked
+
+    install_axe_route(page, base)          # register the test-only route
+    load_axe(page, base)                   # external same-origin <script>
+    assert_inline_scripts_blocked(page)    # CSP regression: inline must stay blocked
+
+Both functions are idempotent and safe to call for every page of a run.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from urllib.parse import urlparse
+
+try:  # pragma: no cover - the pure helpers stay importable without Playwright
+    from playwright.sync_api import Error as PlaywrightError
+except ModuleNotFoundError:  # offline static checks and CI lint jobs
+    class PlaywrightError(RuntimeError):  # type: ignore[no-redef]
+        """Stand-in so this module imports without the browser package."""
+
+AXE_PATH = Path(__file__).resolve().parent / "vendor" / "axe.min.js"
+# Same-origin, test-only path. Never referenced by the production build.
+AXE_ROUTE_PATH = "/__test__/axe.min.js"
+AXE_SELECTOR = "script[data-rawaa-test-axe]"
+
+
+def axe_source() -> str:
+    return AXE_PATH.read_text(encoding="utf-8")
+
+
+def axe_url(base: str) -> str:
+    """Absolute URL on the same origin as `base` (whatever host it is)."""
+    parsed = urlparse(base)
+    origin = f"{parsed.scheme}://{parsed.netloc}"
+    return origin + AXE_ROUTE_PATH
+
+
+def install_axe_route(page, base: str) -> str:
+    """Register a same-origin route that serves the vendored axe bundle."""
+    url = axe_url(base)
+    source = axe_source()
+
+    def _fulfil(route):
+        route.fulfill(status=200, body=source,
+                      headers={"content-type": "text/javascript; charset=utf-8",
+                               "cache-control": "no-store"})
+
+    page.route(url, _fulfil)
+    return url
+
+
+def load_axe(page, base: str, timeout: int = 20000) -> dict:
+    """Inject axe as an external same-origin script and wait until it is ready.
+
+    Returns a small dict describing how the bundle was delivered so a test can
+    assert the CSP-compatible mechanism was actually used.
+    """
+    url = install_axe_route(page, base)
+    # An <img>-free, CSP-neutral check: the element must have a same-origin src,
+    # never inline text, so the audit cannot hide an inline-script regression.
+    handle = page.add_script_tag(url=url, type="text/javascript")
+    page.wait_for_function("() => typeof window.axe === 'object' && typeof window.axe.run === 'function'",
+                           timeout=timeout)
+    info = page.evaluate(
+        """(node) => ({
+            src: node && node.getAttribute('src'),
+            inline: !!node && !!node.textContent && node.textContent.trim().length > 0,
+            axe: typeof window.axe === 'object' && typeof window.axe.run === 'function'
+        })""",
+        handle,
+    )
+    page.evaluate("(node) => node.setAttribute('data-rawaa-test-axe', '1')", handle)
+    return {"url": url, **{k: info[k] for k in ("src", "inline", "axe")}}
+
+
+def csp_from_headers(headers: dict) -> bool:
+    """True when the navigated document was served with a CSP we can test."""
+    if not headers:
+        return False
+    lowered = {str(k).lower(): v for k, v in headers.items()}
+    return "content-security-policy" in lowered
+
+
+def assert_inline_scripts_blocked(page, csp_present: bool | None = None) -> dict:
+    """Positive control: the deployed CSP must still reject inline scripts.
+
+    `csp_present` is derived by the caller from the *response headers* (browsers
+    do not expose them to page script). When a test server emits no CSP at all,
+    the result reports `blocked=False` and `csp_present=False` instead of
+    pretending to have proven containment.
+    """
+    result = page.evaluate(
+        """async () => {
+            const violations = [];
+            const listener = (event) => violations.push({
+                directive: event.effectiveDirective,
+                blocked: event.blockedURI
+            });
+            document.addEventListener('securitypolicyviolation', listener);
+            const probe = document.createElement('script');
+            probe.textContent = 'window.__rawaa_inline_script_executed = true;';
+            document.head.appendChild(probe);
+            await new Promise((resolve) => setTimeout(resolve, 300));
+            const executed = window.__rawaa_inline_script_executed === true;
+            delete window.__rawaa_inline_script_executed;
+            probe.remove();
+            document.removeEventListener('securitypolicyviolation', listener);
+            const meta = document.querySelector('meta[http-equiv="Content-Security-Policy"]');
+            return {meta_present: !!meta, inline_executed: executed, violations: violations};
+        }"""
+    )
+    if csp_present is None:
+        csp_present = bool(result.get("meta_present"))
+    result["csp_present"] = bool(csp_present)
+    result["blocked"] = bool(csp_present) and not result["inline_executed"]
+    return result
+
+
+def csp_probe_headers() -> dict:
+    """Headers the CSP regression test sends so the served page carries its CSP.
+
+    The static preview server used by CI does not reproduce Cloudflare Pages
+    headers, so the harness forwards the exact `_headers` policy for the audit
+    request. The value is read from `_headers` (single source of truth).
+    """
+    headers_file = Path(__file__).resolve().parent.parent / "_headers"
+    if not headers_file.exists():
+        return {}
+    policy = None
+    for line in headers_file.read_text(encoding="utf-8").splitlines():
+        stripped = line.strip()
+        if stripped.lower().startswith("content-security-policy:"):
+            policy = stripped.split(":", 1)[1].strip()
+            break
+    return {"Content-Security-Policy": policy} if policy else {}
+
+
+def csp_summary(result: dict) -> str:
+    """Stable one-line summary for logs (no page content, no secrets)."""
+    violations = result.get("violations") or []
+    directives = sorted({v.get("directive") or "?" for v in violations})
+    return json.dumps({"csp_present": result.get("csp_present"),
+                       "inline_executed": result.get("inline_executed"),
+                       "violations": directives}, ensure_ascii=False)
+
+
+__all__ = ["install_axe_route", "load_axe", "assert_inline_scripts_blocked",
+           "csp_probe_headers", "csp_summary", "csp_from_headers", "axe_url",
+           "axe_source", "AXE_ROUTE_PATH", "AXE_SELECTOR", "PlaywrightError"]
