diff --git a/scripts/csp-axe-harness.test.mjs b/scripts/csp-axe-harness.test.mjs
new file mode 100644
index 0000000..6a5bf18
--- /dev/null
+++ b/scripts/csp-axe-harness.test.mjs
@@ -0,0 +1,92 @@
+/**
+ * حارس انحدار لآلية حقن axe تحت CSP الصارم — بلا متصفح وبلا شبكة.
+ *
+ * الخلفية: PR #158 شدّد CSP إلى `script-src 'self' https://connect.facebook.net`،
+ * فصار `page.add_script_tag(content=...)` (سكربت مضمّن) محجوبًا، وسقطت وظائف
+ * الإتاحة في Chromium وWebKit. الإصلاح: تقديم حزمة axe من نفس الأصل عبر مسار
+ * اختباري، وحقنها كسكربت خارجي — دون إضافة أصل جديد ودون `unsafe-inline`.
+ *
+ * هذا الاختبار يثبّت أربعة أمور:
+ *   1) لا يبقى أي `add_script_tag(content=...)` في أي أداة اختبار.
+ *   2) لا يضعف أحد CSP في `_headers` (لا unsafe-inline / unsafe-eval).
+ *   3) مسار axe الاختباري من نفس الأصل المشتق من `base`، ولا يُبنى منه أصل خارجي.
+ *   4) الحزمة المضمّنة موجودة وغير فارغة، ولا يضيف الخادم مسارًا إنتاجيًا لها.
+ *
+ * التشغيل: node --test scripts/csp-axe-harness.test.mjs
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, readdir, stat } from 'node:fs/promises';
+
+const root = new URL('../', import.meta.url);
+const read = (file) => readFile(new URL(file, root), 'utf8');
+
+const HARNESSES = ['scripts/axe-audit.py', 'scripts/a11y-audit.py',
+  'scripts/serum-browser-test.py', 'scripts/campaign-browser-test.py'];
+
+/**
+ * كود Python بلا تعليقات ولا نصوص توثيق: الحارس يبحث عن استدعاءات فعلية،
+ * لا عن ذكر الآلية المحجوبة في التوثيق الذي يشرح سبب التغيير.
+ */
+function pythonCode(source) {
+  return source
+    .replace(/"""[\s\S]*?"""/g, '')
+    .replace(/'''[\s\S]*?'''/g, '')
+    .split('\n')
+    .map((line) => line.replace(/(^|\s)#.*$/, ''))
+    .join('\n');
+}
+
+test('لا أداة اختبار تحقن axe كمحتوى مضمّن بعد تشديد CSP', async () => {
+  for (const file of HARNESSES) {
+    const source = await read(file);
+    const code = pythonCode(source);
+    const inlineCalls = [...code.matchAll(/add_script_tag\s*\(\s*content\s*=/g)];
+    assert.deepEqual(inlineCalls.map(() => file), [],
+      `${file}: ما زال يستخدم add_script_tag(content=...) المحجوب بـ CSP`);
+    assert.match(code, /from axe_loader import/, `${file}: يجب أن يستخدم أداة الحقن المشتركة`);
+    assert.match(code, /load_axe\(/, `${file}: يجب أن يحمّل axe بنفس آلية CSP`);
+  }
+});
+
+test('أداة الحقن تقدّم axe من نفس الأصل عبر مسار اختباري محصور', async () => {
+  const loader = pythonCode(await read('scripts/axe_loader.py'));
+  assert.match(loader, /AXE_ROUTE_PATH = "\/__test__\/axe\.min\.js"/);
+  assert.match(loader, /page\.add_script_tag\(url=url/,
+    'الحقن يجب أن يكون عبر url لا عبر content');
+  assert.doesNotMatch(loader, /add_script_tag\(\s*content\s*=/,
+    'الأداة نفسها يجب ألا تعود للحقن المضمّن');
+  // المسار نسبي لأصل الصفحة: لا نضيف أصلًا خارجيًا إلى أي سياسة.
+  assert.match(loader, /origin = f"\{parsed\.scheme\}:\/\/\{parsed\.netloc\}"/);
+});
+
+test('حارس CSP لا يسمح بضعف السياسة في _headers', async () => {
+  const headers = await read('_headers');
+  const csp = headers.split('\n').find((line) => line.trim().toLowerCase().startsWith('content-security-policy:'));
+  assert.ok(csp, '_headers يجب أن يعلن CSP');
+  assert.doesNotMatch(csp, /unsafe-inline/, 'CSP يجب ألا يسمح بسكربت مضمّن');
+  assert.doesNotMatch(csp, /unsafe-eval/, 'CSP يجب ألا يسمح بتقييم ديناميكي');
+  assert.match(csp, /script-src 'self'/, "script-src يجب أن يسمح بالنفس فقط للأصول المحلية");
+  // الحزمة تُقدَّم من نفس الأصل، لذا لا حاجة لأي مصدر سكربت إضافي.
+  const loader = await read('scripts/axe_loader.py');
+  assert.match(loader, /_headers/);
+});
+
+test('حزمة axe المضمّنة موجودة، غير فارغة، وليست أصلًا إنتاجيًا', async () => {
+  const axe = await stat(new URL('scripts/vendor/axe.min.js', root));
+  assert.ok(axe.size > 100_000, 'حزمة axe غير مكتملة');
+  const production = await read('_headers');
+  assert.doesNotMatch(production, /__test__/, 'مسار الاختبار يجب ألا يظهر في سياسة الإنتاج');
+  assert.doesNotMatch(production, /axe\.min\.js/, 'حزمة axe لا تُنشر مع الموقع');
+  const buildScript = await read('scripts/build-deploy.sh');
+  assert.doesNotMatch(buildScript, /axe\.min\.js/, 'البناء لا ينسخ حزمة axe إلى dist');
+});
+
+test('لا ملف إنتاج يشير إلى مسار axe الاختباري', async () => {
+  const distributionFiles = await readdir(new URL('.', root));
+  assert.ok(distributionFiles.length > 0);
+  for (const file of ['index.html', 'serum.html', 'campaign.html', 'hama.html', 'sw.js']) {
+    const source = await read(file);
+    assert.doesNotMatch(source, /__test__\/axe/, `${file}: تسرّب مسار اختباري إلى الإنتاج`);
+  }
+});
