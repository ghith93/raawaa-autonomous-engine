diff --git a/scripts/delivery-contract.test.mjs b/scripts/delivery-contract.test.mjs
new file mode 100644
index 0000000..199b489
--- /dev/null
+++ b/scripts/delivery-contract.test.mjs
@@ -0,0 +1,129 @@
+/**
+ * عقد التوصيل المعتمد من المالك (٧ تشرين الثاني ٢٠٢٦) — اختبار الانحدار الرباعي.
+ *
+ * القاعدة:
+ *   حماة:       0$ لكل طرق الدفع (شام كاش والدفع عند الاستلام).
+ *   باقي المحافظات: 2$ لكل طرق الدفع.
+ *
+ * الاختبار يتحقق من ثلاث طبقات تعرض الرقم للزبونة، لأن أي انحراف بينها يعني
+ * سلة تعرض مبلغًا ورسالة واتساب تعرض غيره:
+ *   1) السلة في المتصفح (`js/cart.js`) كما تُحمّل فعليًا في `serum.html`.
+ *   2) محرّك التسعير الخادمي (`order-system/order-core.mjs`).
+ *   3) نصوص الصفحات وعدّة التشغيل — لا يجوز أن تعلن 2$ داخل حماة بعد اليوم.
+ *
+ * التشغيل: node --test scripts/delivery-contract.test.mjs
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import vm from 'node:vm';
+import { JSDOM } from 'jsdom';
+import { prepareOrder } from '../order-system/order-core.mjs';
+
+const root = new URL('../', import.meta.url);
+const read = (file) => readFile(new URL(file, root), 'utf8');
+
+const configJs = await read('js/config.js');
+const cartJs = await read('js/cart.js');
+const offersJs = await read('js/offers.js');
+
+// نقرأ الإعدادات من المصدر نفسه لا من نسخة مكرّرة في الاختبار.
+const sandbox = { window: {} };
+vm.runInNewContext(configJs, sandbox);
+const config = sandbox.window.RAWAA_CONFIG;
+
+/** سلة حقيقية في jsdom بنفس ترتيب تحميل الصفحة. */
+async function bootCart() {
+  const page = (await read('serum.html')).replace(/<script[\s\S]*?<\/script>/g, '');
+  const dom = new JSDOM(page, {
+    url: 'https://raawaa-store.pages.dev/serum',
+    runScripts: 'outside-only',
+    pretendToBeVisual: true
+  });
+  const { window } = dom;
+  window.matchMedia = window.matchMedia || (() => ({
+    matches: false, addEventListener() {}, removeEventListener() {}, addListener() {}, removeListener() {}
+  }));
+  window.IntersectionObserver = window.IntersectionObserver || class {
+    observe() {} unobserve() {} disconnect() {}
+  };
+  window.scrollTo = () => {};
+  await new Promise((resolve) => setTimeout(resolve, 0));
+  window.eval(configJs);
+  window.eval(offersJs);
+  window.eval(cartJs);
+  return window;
+}
+
+const CASES = [
+  { zone: 'hama', method: 'cod', delivery: 0, label: 'حماة / الدفع عند الاستلام' },
+  { zone: 'hama', method: 'shamcash', delivery: 0, label: 'حماة / شام كاش' },
+  { zone: 'other', method: 'cod', delivery: 2, label: 'باقي المحافظات / الدفع عند الاستلام' },
+  { zone: 'other', method: 'shamcash', delivery: 2, label: 'باقي المحافظات / شام كاش' }
+];
+
+test('الإعدادات تعرّف حماة برسم صفر وباقي المحافظات برسم 2$', () => {
+  const fee = (id) => config.delivery.zones.find((zone) => zone.id === id).fee;
+  assert.equal(fee('hama'), 0, 'حماة مستثناة من الرسوم');
+  assert.equal(fee('other'), 2, 'باقي المحافظات 2$');
+});
+
+test('السلة تحسب الحالات الأربع بمبلغ التوصيل المعتمد لكل طريقة دفع', async () => {
+  const w = await bootCart();
+  const api = w.__RAWAA_TEST__;
+  const product = config.products.find((item) => item.id === 'serum-50');
+  api.addToCart('serum-50');
+
+  for (const { zone, method, delivery, label } of CASES) {
+    api.setZone(zone, true);
+    api.setMethod(method, true);
+    const totals = api.totals();
+    assert.equal(totals.delivery, delivery, `${label}: رسم التوصيل`);
+    assert.equal(totals.freeDelivery, delivery === 0, `${label}: علم المجانية`);
+
+    const discount = method === 'shamcash' ? product.price * 0.1 : 0;
+    const expected = Number((product.price - discount + delivery).toFixed(2));
+    assert.equal(totals.amount, expected, `${label}: الإجمالي`);
+
+    // رسالة واتساب يجب أن تعلن المبلغ نفسه الذي تراه الزبونة في السلة.
+    const message = api.buildOrderMessage();
+    assert.match(message, new RegExp('المجموع المرجعي: \\$' + String(expected).replace(/\.0$/, '')), `${label}: رسالة واتساب`);
+    if (delivery === 0) assert.match(message, /التوصيل: مجاني/, `${label}: نص المجانية`);
+    else assert.match(message, /رسوم التوصيل: \$2/, `${label}: نص الرسوم`);
+  }
+  w.close();
+});
+
+test('المحرّك الخادمي يوافق السلة في الحالات الأربع', () => {
+  const base = {
+    name: 'زبونة تجريبية',
+    phone: '0991234567',
+    address: 'حماة',
+    items: [{ id: 'serum-50', qty: 1 }]
+  };
+  for (const { zone, method, delivery, label } of CASES) {
+    const order = prepareOrder({ ...base, zone, method }, config);
+    assert.equal(order.zone, zone);
+    assert.equal(order.method, method);
+    assert.equal(order.deliveryCents, delivery * 100, `${label}: رسم التوصيل خادميًا`);
+    const discount = method === 'shamcash' ? Math.round(1600 * 0.1) : 0;
+    assert.equal(order.totalCents, 1600 - discount + delivery * 100, `${label}: الإجمالي خادميًا`);
+  }
+});
+
+test('نصوص الصفحات لا تعلن رسومًا داخل حماة بعد اعتماد التوصيل المجاني', async () => {
+  for (const file of ['index.html', 'serum.html', 'hama.html']) {
+    const html = await read(file);
+    // نبحث عن أي عبارة تربط حماة برسم 2$ صريحًا.
+    const claims = [
+      /توصيل(?:[^<>]{0,40})حماة[^<>]{0,20}(?:\$2|٢\$)/g,
+      /حماة[^<>]{0,30}(?:\$2|٢\$)[^<>]{0,20}توصيل/g,
+      /الدفع عند الاستلام[^<>]{0,20}(?:\$2|٢\$)[^<>]{0,10}حماة/g
+    ];
+    for (const pattern of claims) {
+      const found = html.match(pattern) || [];
+      assert.deepEqual(found, [], `${file}: نص يخالف قاعدة التوصيل المجاني داخل حماة → ${found.join(' | ')}`);
+    }
+    assert.match(html, /(?:توصيل|التوصيل)[^<>]{0,40}(?:مجاني|مجانًا)/, `${file}: يجب أن تذكر الصفحة التوصيل المجاني`);
+  }
+});
